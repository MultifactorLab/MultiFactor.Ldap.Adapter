<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<!--
	Multi-domain setup: save one clients/<domain>.config per domain beside the
	adapter executable and replace the example values. *.template files are ignored.
	Routing uses the client's source IP, not the login domain: IP ranges must not
	overlap; unknown IPs are rejected. Keep endpoints, API URL and logging in the
	main config; client settings are not inherited from it.
	-->

	<configSections>
		<section name="UserNameTransformRules" type="MultiFactor.Ldap.Adapter.Configuration.UserNameTransformRulesSection, MultiFactor.Ldap.Adapter" />
	</configSections>
	
	<appSettings>
		<!--Source IP of the connecting LDAP client, not the domain controller.
		Use a single IP, a subnet or a range; separate multiple entries with semicolons.
		For a second domain, use a different source IP or subnet, e.g. 192.168.1.0/24.-->
		<add key="ldap-client-ip" value="192.168.0.0/255.255.255.0"/>
		<!--Replace with the LDAP or LDAPS address of this domain's controller.-->
		<add key="ldap-server" value="ldap://dc.domain.local"/>

		<!--List of service accounts (Bind DN) delimited by semicolons (option 1).
		Replace with real accounts or remove this setting if unused.-->
		<add key="ldap-service-accounts" value="CN=Service Acc1,OU=Users,DC=domain,DC=local"/>

		<!--Service accounts (Bind DN) organizational unit (OU) (option 2).
		Replace with the real OU or remove this setting if unused.-->
		<add key="ldap-service-accounts-ou" value="OU=Service Accounts"/>

		<!--Optional: uncomment and set a real group to allow access only to its members.-->
		<!--<add key="active-directory-group" value="MyApp Users"/>-->

		<!--Optional: uncomment and set a real group to require 2FA only for its members.
		When omitted, this group-based restriction on requiring 2FA does not apply.-->
		<!--<add key="active-directory-2fa-group" value="MyApp 2FA Users"/>-->

		<!--Multifactor API -->
		<!-- get it from multifactor management panel -->
		<add key="multifactor-nas-identifier" value="1"/>
		<!-- get it from multifactor management panel -->
		<add key="multifactor-shared-secret" value="2"/>
	</appSettings>
	
</configuration>
